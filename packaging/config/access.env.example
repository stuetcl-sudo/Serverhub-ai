# Optional direct HTTPS listener; root:serverhub-ai-api 0640 at /etc/serverhub/access.env.
# Only configure an address assigned to THIS controller. Do not use a production
# host's IP for a test-VM installation. Certificates must include the host/IP SAN.
SERVERHUB_API_BIND=192.168.122.10
SERVERHUB_API_PORT=9080
SERVERHUB_PUBLIC_URL=https://192.168.122.10:9080
SERVERHUB_TLS_CERTFILE=/etc/serverhub/tls/fullchain.pem
SERVERHUB_TLS_KEYFILE=/etc/serverhub/tls/privkey.pem
SERVERHUB_HEALTH_URL=https://192.168.122.10:9080
# Omit for publicly trusted certificates; use a CA certificate for a private PKI.
SERVERHUB_HEALTH_CA=/etc/serverhub/tls/ca.pem
