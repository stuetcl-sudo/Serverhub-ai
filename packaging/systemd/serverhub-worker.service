[Unit]
Description=ServerHub AI OS persistent job worker
After=network-online.target postgresql.service serverhub-api.service
Wants=network-online.target
[Service]
Type=simple
User=serverhub-worker
Group=serverhub-worker
WorkingDirectory=/opt/serverhub/current
EnvironmentFile=/etc/serverhub/worker.env
ExecStart=/opt/serverhub/current/venv/bin/serverhub worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/serverhub-worker
InaccessiblePaths=/etc/serverhub/api.env /etc/serverhub/recovery.env /etc/serverhub/broker.yaml /var/backups/serverhub /var/lib/serverhub-recovery /var/lib/serverhub-release /var/run/docker.sock /run/serverhub-broker /var/lib/serverhub-node
MemoryMax=4G
TasksMax=256
[Install]
WantedBy=multi-user.target
