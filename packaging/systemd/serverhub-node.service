[Unit]
Description=ServerHub native Linux node agent
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=serverhub-node
Group=serverhub-node
WorkingDirectory=/var/lib/serverhub-node
ExecStart=/opt/serverhub/current/venv/bin/python -m serverhub.node.agent --config /etc/serverhub/node.yaml
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/serverhub-node
InaccessiblePaths=-/etc/serverhub/api.env -/etc/serverhub/worker.env -/etc/serverhub/recovery.env /etc/serverhub/broker.yaml /var/backups/serverhub /var/lib/serverhub-recovery /var/lib/serverhub-release -/var/run/docker.sock
MemoryMax=512M
TasksMax=64
[Install]
WantedBy=multi-user.target
