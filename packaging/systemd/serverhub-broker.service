[Unit]
Description=ServerHub constrained local privileged broker
After=docker.service
[Service]
Type=simple
User=root
Group=serverhub-node
WorkingDirectory=/
RuntimeDirectory=serverhub-broker
RuntimeDirectoryMode=0750
ExecStart=/opt/serverhub/current/venv/bin/python -m serverhub.node.broker --config /etc/serverhub/broker.yaml
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/run/serverhub-broker /var/log/serverhub-broker -/var/log/lynis.log -/var/log/lynis-report.dat
LogsDirectory=serverhub-broker
LogsDirectoryMode=0700
InaccessiblePaths=/var/backups/serverhub /var/lib/serverhub-release /etc/serverhub/recovery.env -/etc/serverhub/api.env -/etc/serverhub/worker.env
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=1G
TasksMax=64
[Install]
WantedBy=multi-user.target
